<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================
         COLOR PALETTE & BRUSHES
         =================================== -->
    
    <!-- Colors -->
    <Color x:Key="GlobalBg">#F2F2F2</Color>
    <Color x:Key="GlobalBorder">#BFC5CC</Color>
    <Color x:Key="GlobalLegend">#6D7782</Color>
    <Color x:Key="GlobalInputBg">#FFFFFF</Color>
    <Color x:Key="GlobalReadonlyBg">#F3F5F7</Color>
    <Color x:Key="GlobalPrimary">#DCEBFF</Color>
    <Color x:Key="GlobalDanger">#E7222A</Color>
    <Color x:Key="GlobalDangerText">#FFFFFF</Color>
    <Color x:Key="GlobalSuccess">#28A745</Color>
    <Color x:Key="GlobalWarning">#FFC107</Color>
    <Color x:Key="GlobalInfo">#17A2B8</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="GlobalBgBrush" Color="{StaticResource GlobalBg}" />
    <SolidColorBrush x:Key="GlobalBorderBrush" Color="{StaticResource GlobalBorder}" />
    <SolidColorBrush x:Key="GlobalLegendBrush" Color="{StaticResource GlobalLegend}" />
    <SolidColorBrush x:Key="GlobalInputBgBrush" Color="{StaticResource GlobalInputBg}" />
    <SolidColorBrush x:Key="GlobalReadonlyBgBrush" Color="{StaticResource GlobalReadonlyBg}" />
    <SolidColorBrush x:Key="GlobalPrimaryBrush" Color="{StaticResource GlobalPrimary}" />
    <SolidColorBrush x:Key="GlobalDangerBrush" Color="{StaticResource GlobalDanger}" />
    <SolidColorBrush x:Key="GlobalDangerTextBrush" Color="{StaticResource GlobalDangerText}" />
    <SolidColorBrush x:Key="GlobalSuccessBrush" Color="{StaticResource GlobalSuccess}" />
    <SolidColorBrush x:Key="GlobalWarningBrush" Color="{StaticResource GlobalWarning}" />
    <SolidColorBrush x:Key="GlobalInfoBrush" Color="{StaticResource GlobalInfo}" />

    <!-- ===================================
         SIZING CONSTANTS
         =================================== -->
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="DefaultFontSize">12</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="LabelFontSize">12</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="HeaderFontSize">14</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="SmallFontSize">11</System:Double>

    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="InputHeight">24</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="ButtonHeight">28</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="LargeButtonHeight">32</System:Double>

    <Thickness x:Key="StandardMargin">4</Thickness>
    <Thickness x:Key="StandardPadding">4,1</Thickness>
    <Thickness x:Key="LargeMargin">8</Thickness>
    <Thickness x:Key="ControlMargin">2</Thickness>

    <!-- ===================================
         GLOBAL TEXT STYLES
         =================================== -->

    <!-- Default TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource GlobalLegendBrush}"/>
    </Style>

    <!-- Label TextBlock -->
    <Style x:Key="LabelTextBlock" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{StaticResource LabelFontSize}"/>
        <Setter Property="Foreground" Value="#111"/>
    </Style>

    <!-- Header TextBlock -->
    <Style x:Key="HeaderTextBlock" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlock}">
        <Setter Property="FontSize" Value="{StaticResource HeaderFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ===================================
         INPUT CONTROLS (TEXTBOX, COMBOBOX, DATEPICKER)
         =================================== -->

    <!-- Default TextBox - Compact with FontSize 12 -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource InputHeight}"/>
        <Setter Property="Padding" Value="{StaticResource StandardPadding}"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="Background" Value="{StaticResource GlobalInputBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlobalBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Styled TextBox - with key for backward compatibility -->
    <Style x:Key="PeTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    </Style>

    <!-- Read-Only TextBox -->
    <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="{StaticResource GlobalReadonlyBgBrush}"/>
    </Style>

    <!-- Backward compatibility -->
    <Style x:Key="PeReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyTextBox}">
    </Style>

    <!-- Default ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource InputHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlobalBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Styled ComboBox - with key for backward compatibility -->
    <Style x:Key="PeComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    </Style>

    <!-- Default DatePicker -->
    <Style TargetType="DatePicker">
        <Setter Property="Height" Value="{StaticResource InputHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
    </Style>

    <!-- Styled DatePicker - with key for backward compatibility -->
    <Style x:Key="PeDatePicker" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
    </Style>

    <!-- ===================================
         BUTTON STYLES
         =================================== -->

    <!-- Default Button -->
    <Style TargetType="Button">
        <Setter Property="Height" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="Margin" Value="{StaticResource ControlMargin}"/>
        <Setter Property="Background" Value="{StaticResource GlobalPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#7EA6D8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Primary Button -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource GlobalPrimaryBrush}"/>
    </Style>

    <!-- Styled Button - with key for backward compatibility -->
    <Style x:Key="PeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    </Style>

    <!-- Danger Button -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#FF7B7B"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#D45151"/>
    </Style>

    <!-- Backward compatibility -->
    <Style x:Key="PeDangerButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
    </Style>

    <!-- Success Button -->
    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource GlobalSuccessBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ===================================
         CHECKBOX & RADIOBUTTON
         =================================== -->

    <!-- Default CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="{StaticResource ControlMargin}"/>
    </Style>

    <!-- Default RadioButton -->
    <Style TargetType="RadioButton">
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="{StaticResource ControlMargin}"/>
    </Style>

    <!-- ===================================
         CONTAINER STYLES (GROUPBOX, BORDER)
         =================================== -->

    <!-- Default GroupBox -->
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlobalBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource GlobalLegendBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        
    </Style>

    <!-- Styled GroupBox - with key for backward compatibility -->
    <Style x:Key="PeGroupBox" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
    </Style>

    <!-- Default Border -->
    <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource GlobalBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ===================================
         DATAGRID
         =================================== -->

    <!-- Default DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlobalBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>

    <!-- Styled DataGrid - with key for backward compatibility -->
    <Style x:Key="PeDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
    </Style>

    <!-- ===================================
         SPECIAL STYLES
         =================================== -->

    <!-- Object Type Banner (Red emphasis) -->
    <Style x:Key="ObjectTypeBanner" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyTextBox}">
        <Setter Property="Background" Value="{StaticResource GlobalDangerBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource GlobalDangerTextBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Height" Value="30"/>
    </Style>

    <!-- Backward compatibility -->
    <Style x:Key="PeObjectTypeBanner" TargetType="TextBox" BasedOn="{StaticResource ObjectTypeBanner}">
    </Style>

    <!-- Price Break TextBox (for validation states) -->
    <Style x:Key="PriceBreakTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="White"/>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="Background" Value="#F07474"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Success Banner -->
    <Style x:Key="SuccessBanner" TargetType="Border">
        <Setter Property="Background" Value="#EAF6EA"/>
        <Setter Property="BorderBrush" Value="#8BC48B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <!-- Warning Banner -->
    <Style x:Key="WarningBanner" TargetType="Border">
        <Setter Property="Background" Value="#FFF3CD"/>
        <Setter Property="BorderBrush" Value="#FFC107"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <!-- Danger Banner -->
    <Style x:Key="DangerBanner" TargetType="Border">
        <Setter Property="Background" Value="#F8D7DA"/>
        <Setter Property="BorderBrush" Value="#E7222A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <!-- ===================================
         LEGACY COMPATIBILITY MAPPINGS
         =================================== -->
    
    <!-- Map old Pe* brushes to new Global* brushes for backward compatibility -->
    <SolidColorBrush x:Key="PeBgBrush" Color="{StaticResource GlobalBg}" />
    <SolidColorBrush x:Key="PeBorderBrush" Color="{StaticResource GlobalBorder}" />
    <SolidColorBrush x:Key="PeLegendBrush" Color="{StaticResource GlobalLegend}" />
    <SolidColorBrush x:Key="PeInputBgBrush" Color="{StaticResource GlobalInputBg}" />
    <SolidColorBrush x:Key="PeReadonlyBgBrush" Color="{StaticResource GlobalReadonlyBg}" />
    <SolidColorBrush x:Key="PePrimaryBrush" Color="{StaticResource GlobalPrimary}" />
    <SolidColorBrush x:Key="PeDangerBrush" Color="{StaticResource GlobalDanger}" />
    <SolidColorBrush x:Key="PeDangerTextBrush" Color="{StaticResource GlobalDangerText}" />

    <!-- Map old Pe* label style to new LabelTextBlock -->
    <Style x:Key="PeLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlock}">
    </Style>

</ResourceDictionary>