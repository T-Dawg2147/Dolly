<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="PeBg">#F2F2F2</Color>
    <Color x:Key="PeBorder">#BFC5CC</Color>
    <Color x:Key="PeLegend">#6D7782</Color>
    <Color x:Key="PeInputBg">#FFFFFF</Color>
    <Color x:Key="PeReadonlyBg">#F3F5F7</Color>
    <Color x:Key="PePrimary">#DCEBFF</Color>
    <Color x:Key="PeDanger">#E7222A</Color>
    <Color x:Key="PeDangerText">#FFFFFF</Color>

    <SolidColorBrush x:Key="PeBgBrush" Color="{StaticResource PeBg}" />
    <SolidColorBrush x:Key="PeBorderBrush" Color="{StaticResource PeBorder}" />
    <SolidColorBrush x:Key="PeLegendBrush" Color="{StaticResource PeLegend}" />
    <SolidColorBrush x:Key="PeInputBgBrush" Color="{StaticResource PeInputBg}" />
    <SolidColorBrush x:Key="PeReadonlyBgBrush" Color="{StaticResource PeReadonlyBg}" />
    <SolidColorBrush x:Key="PePrimaryBrush" Color="{StaticResource PePrimary}" />
    <SolidColorBrush x:Key="PeDangerBrush" Color="{StaticResource PeDanger}" />
    <SolidColorBrush x:Key="PeDangerTextBrush" Color="{StaticResource PeDangerText}" />

    <!-- GroupBox style -->
    <Style x:Key="PeGroupBox" TargetType="GroupBox">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderBrush" Value="{StaticResource PeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource PeLegendBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="Transparent"
                                CornerRadius="2"
                                Margin="0,8,0,0"/>
                        <Border Background="{StaticResource PeBgBrush}" Margin="10,0,0,0" Padding="4,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" Margin="6"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Labels -->
    <Style x:Key="PeLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#111"/>
    </Style>

    <!-- Inputs -->
    <Style x:Key="PeTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="{StaticResource PeInputBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="PeReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource PeTextBox}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="{StaticResource PeReadonlyBgBrush}"/>
    </Style>

    <Style x:Key="PeComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderBrush" Value="{StaticResource PeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="PeDatePicker" TargetType="DatePicker">
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="PeButton" TargetType="Button">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Background" Value="{StaticResource PePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#7EA6D8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="PeDangerButton" TargetType="Button" BasedOn="{StaticResource PeButton}">
        <Setter Property="Background" Value="#FF7B7B"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#D45151"/>
    </Style>

    <!-- Object type red banner -->
    <Style x:Key="PeObjectTypeBanner" TargetType="TextBox" BasedOn="{StaticResource PeReadOnlyTextBox}">
        <Setter Property="Background" Value="{StaticResource PeDangerBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PeDangerTextBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Height" Value="30"/>
    </Style>

    <!-- DataGrid -->
    <Style x:Key="PeDataGrid" TargetType="DataGrid">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="BorderBrush" Value="{StaticResource PeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>
</ResourceDictionary>