<Window x:Class="Dolly.Desktop.Views.SearchResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Dolly.Desktop.Converters"
        Title="Search Results" Width="900" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PeBgBrush}">
    
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Results for" Style="{StaticResource PeLabel}"/>
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource PeTextBox}"
                     KeyDown="SearchTextBox_OnKeyDown"/>
            <Button Grid.Column="2" Content="🔎" Command="{Binding RunSearchCommand}" Style="{StaticResource PeButton}"/>
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{Binding FoundSummary}" Style="{StaticResource PeLabel}"/>

        <!-- Exact match strip -->
        <Border Grid.Row="3"
                Padding="8"
                Background="#EAF6EA"
                BorderBrush="#8BC48B"
                BorderThickness="1"
                Visibility="{Binding ShowExactSection, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Found In" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding ExactSummaryText}" VerticalAlignment="Center"/>
                <Button Grid.Column="2"
                        HorizontalAlignment="Right"
                        Content="Open Exact Match"
                        Command="{Binding OpenFirstExactCommand}"
                        Style="{StaticResource PeButton}"/>
            </Grid>
        </Border>

        <!-- exact list -->
        <GroupBox Grid.Row="5"
                  Header="Search Results"
                  Style="{StaticResource PeGroupBox}">
            <DataGrid x:Name="ResultsGrid"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedResult}"
                      MouseDoubleClick="ResultsGrid_OnMouseDoubleClick"
                      Style="{StaticResource PeDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="220"/>
                    <DataGridTextColumn Header="Found In" Binding="{Binding FoundIn}" Width="230"/>
                    <DataGridTextColumn Header="Found" Binding="{Binding Found}" Width="*"/>
                    <DataGridTextColumn Header="Click to go to" Binding="{Binding KeyValue}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>