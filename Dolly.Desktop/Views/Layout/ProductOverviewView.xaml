<UserControl x:Class="Dolly.Desktop.Views.Layout.ProductOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#B7B7B7" BorderThickness="1" Background="#EEF3DF">
            <TextBlock Text="{Binding HeaderText}"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/>
                <RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/>
                <RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/>
                <RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Part No" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PartNo}" Style="{StaticResource PeReadOnlyTextBox}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="MOQ" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Moq}" Style="{StaticResource PeReadOnlyTextBox}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Stock Status" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StockStatus}" Style="{StaticResource PeReadOnlyTextBox}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Lead Time" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding LeadTime}" Style="{StaticResource PeReadOnlyTextBox}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Stock Control" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StockControl}" Style="{StaticResource PeReadOnlyTextBox}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Date Into Stock" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding DateIntoStock}" Style="{StaticResource PeReadOnlyTextBox}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Next Day" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NextDay}" Style="{StaticResource PeReadOnlyTextBox}"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="Available Stock" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding AvailableStock}" Style="{StaticResource PeReadOnlyTextBox}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Run To Zero" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RunToZero}" Style="{StaticResource PeReadOnlyTextBox}"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Text="Back Orders" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding BackOrders}" Style="{StaticResource PeReadOnlyTextBox}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="List Price" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ListPrice}" Style="{StaticResource PeReadOnlyTextBox}"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Discount" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Discount}" Style="{StaticResource PeReadOnlyTextBox}"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Net Cost" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding NetCost}" Style="{StaticResource PeReadOnlyTextBox}"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Landed Cost" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding LandedCost}" Style="{StaticResource PeReadOnlyTextBox}"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Carriage" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Carriage}" Style="{StaticResource PeReadOnlyTextBox}"/>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Additional Costs" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding AdditionalCosts}" Style="{StaticResource PeReadOnlyTextBox}"/>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Total Cost" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding TotalCost}" Style="{StaticResource PeReadOnlyTextBox}"/>
            <TextBlock Grid.Row="11" Grid.Column="2" Text="Selling Price €" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Row="11" Grid.Column="3" Text="{Binding SellingPriceEuro}" Style="{StaticResource PeReadOnlyTextBox}"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Sales Message" VerticalAlignment="Center" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Column="1" Text="{Binding SalesMessage}" Style="{StaticResource PeReadOnlyTextBox}"/>
        </Grid>
    </Grid>
</UserControl>