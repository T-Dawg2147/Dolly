<UserControl x:Class="Dolly.Desktop.Views.Layout.ProductsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxWidth="1920"
             MinWidth="1080">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="8,6"
                Background="#FFF7E6"
                BorderBrush="#E6B800"
                BorderThickness="1"
                Visibility="{Binding IsGroupFilterActive, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding ActiveParentFilter, StringFormat='Group filter active: Parent_ID = {0}'}"/>
                <Button DockPanel.Dock="Right"
                        Margin="10,0,0,0"
                        Padding="10,2"
                        Content="Clear Filter"
                        Command="{Binding ClearGroupFilterCommand}"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Products">
                <DataGrid ItemsSource="{Binding ProductsView}"
                          SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HorizontalScrollBarVisibility="Visible"
                          VerticalScrollBarVisibility="Visible"
                          MouseDoubleClick="DesignNo_OnMouseDoubleClick">
                    <DataGrid.Columns>
                    <DataGridTextColumn Header="Supplier Code" Binding="{Binding SupplierCode}" Width="95"/>
                    <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="140"/>
                    <DataGridTextColumn Header="Product Manager" Binding="{Binding ProductManager}" Width="120"/>
                    <DataGridTextColumn Header="Page No" Binding="{Binding PageNo}" Width="60"/>
                    <DataGridTextColumn Header="Old Page No" Binding="{Binding OldPageNo}" Width="75"/>
                    <DataGridTextColumn Header="PGRP" Binding="{Binding Parent}" Width="85"/>
                    <DataGridTextColumn Header="Base Code" Binding="{Binding BaseCode}" Width="95"/>
                    <DataGridTextColumn Header="Supplier Part No" Binding="{Binding SupplierProductCode}" Width="120"/>
                    <DataGridTextColumn Header="DesignNo" Binding="{Binding DesignNo}" Width="80"/>
                    <DataGridTextColumn Header="Parent" Width="80"/>
                    <DataGridTextColumn Header="Description 1" Binding="{Binding Description1}" Width="220"/>
                    <DataGridTextColumn Header="Description 2" Binding="{Binding Description2}" Width="220"/>
                    <DataGridTextColumn Header="Stock Status" Binding="{Binding StockStatus}" Width="95"/>
                    <DataGridTextColumn Header="Stock Control" Binding="{Binding StockControl}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Next Day" Binding="{Binding NextDay}" Width="70"/>
                    <DataGridCheckBoxColumn Header="Run to Zero" Binding="{Binding RunToZero}" Width="85"/>

                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="75"/>
                    <DataGridTextColumn Header="On Order" Binding="{Binding OnOrder}" Width="80"/>
                    <DataGridTextColumn Header="Back Orders" Binding="{Binding BackOrders}" Width="90"/>
                    <DataGridTextColumn Header="Lead Time" Binding="{Binding LeadTime}" Width="75"/>

                    <DataGridTextColumn Header="List Price" Binding="{Binding ListPrice, StringFormat={}{0:F2}}" Width="80"/>
                    <DataGridTextColumn Header="Discount" Binding="{Binding Discount, StringFormat={}{0:P2}}" Width="80"/>
                    <DataGridTextColumn Header="Net Cost" Binding="{Binding NetCost, StringFormat={}{0:F2}}" Width="80"/>
                    <DataGridTextColumn Header="Net Cost 2" Binding="{Binding NetCost2, StringFormat={}{0:F2}}" Width="85"/>
                    <DataGridTextColumn Header="Net Cost 3" Binding="{Binding NetCost3, StringFormat={}{0:F2}}" Width="85"/>
                    <DataGridTextColumn Header="Min Qty 2" Binding="{Binding MinQty2}" Width="80"/>
                    <DataGridTextColumn Header="Min Qty 3" Binding="{Binding MinQty3}" Width="80"/>

                    <DataGridTextColumn Header="Currency Rate" Binding="{Binding CurrencyRate}" Width="95"/>
                    <DataGridTextColumn Header="Freight In" Binding="{Binding FreightIn}" Width="80"/>
                    <DataGridTextColumn Header="Settlement Disc" Binding="{Binding SettlementDisc}" Width="100"/>
                    <DataGridTextColumn Header="Standard Cost" Binding="{Binding StandardCost}" Width="95"/>

                    <DataGridTextColumn Header="Carriage Type" Binding="{Binding CarriageType}" Width="100"/>
                    <DataGridTextColumn Header="Freight Out" Binding="{Binding FreightOut}" Width="85"/>
                    <DataGridTextColumn Header="Carriage Charge" Binding="{Binding CarriageCharge}" Width="105"/>
                    <DataGridTextColumn Header="Despatch Method" Binding="{Binding ShippingMethod}" Width="115"/>
                    <DataGridTextColumn Header="Carriage" Binding="{Binding Carriage}" Width="80"/>
                    <DataGridTextColumn Header="Additional Costs" Binding="{Binding AdditionalCosts}" Width="105"/>
                    <DataGridTextColumn Header="Total Cost" Binding="{Binding TotalCost}" Width="90"/>

                    <DataGridTextColumn Header="Price 1" Binding="{Binding Price1}" Width="75"/>
                    <DataGridTextColumn Header="Price 2" Binding="{Binding Price2}" Width="75"/>
                    <DataGridTextColumn Header="Price 3" Binding="{Binding Price3}" Width="75"/>
                    <DataGridTextColumn Header="Price Break 2" Binding="{Binding PriceBreak2}" Width="95"/>
                    <DataGridTextColumn Header="Price Break 3" Binding="{Binding PriceBreak3}" Width="95"/>

                    <DataGridTextColumn Header="Margin" Binding="{Binding Margin, StringFormat={}{0:P2}}" Width="80"/>
                    <DataGridTextColumn Header="Small Margin" Binding="{Binding SmallMargin, StringFormat={}{0:P2}}" Width="90"/>

                    <DataGridTextColumn Header="Zone A" Binding="{Binding ZoneA}" Width="70"/>
                    <DataGridTextColumn Header="Zone B" Binding="{Binding ZoneB}" Width="70"/>
                    <DataGridTextColumn Header="Zone C" Binding="{Binding ZoneC}" Width="70"/>
                    <DataGridTextColumn Header="Zone D" Binding="{Binding ZoneD}" Width="70"/>
                    <DataGridTextColumn Header="Zone E" Binding="{Binding ZoneE}" Width="70"/>
                    <DataGridTextColumn Header="Zone S" Binding="{Binding ZoneS}" Width="70"/>
                </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Sales">
                <DataGrid ItemsSource="{Binding Sales}"
                          SelectedItem="{Binding SelectedSalesRow}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="DesignNo_OnMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="120"/>
                        <DataGridTextColumn Header="Product Manager" Binding="{Binding ProductManager}" Width="130"/>
                        <DataGridTextColumn Header="Supplier Code" Binding="{Binding SupplierCode}" Width="100"/>
                        <DataGridTextColumn Header="Supplier Part No" Binding="{Binding SupplierProductCode}" Width="140"/>
                        <DataGridTextColumn Header="Heading" Binding="{Binding Heading}" Width="240"/>
                        <DataGridTextColumn Header="Page No" Binding="{Binding PageNo}" Width="70"/>
                        <DataGridTextColumn Header="Design No" Binding="{Binding DesignNo}" Width="90"/>
                        <DataGridTextColumn Header="Parent" Binding="{Binding ParentId}" Width="90"/>
                        <DataGridTextColumn Header="Object Type" Binding="{Binding ObjectType}" Width="110"/>
                        <DataGridTextColumn Header="Long Description 1" Binding="{Binding LongDescription1}" Width="250"/>
                        <DataGridTextColumn Header="Long Description 2" Binding="{Binding LongDescription2}" Width="250"/>

                        <DataGridTextColumn Header="2Y Orders" Binding="{Binding OrdersTwoYear}" Width="80"/>
                        <DataGridTextColumn Header="2Y Units" Binding="{Binding UnitsTwoYear}" Width="80"/>
                        <DataGridTextColumn Header="2Y Costs" Binding="{Binding CostsTwoYear, StringFormat={}{0:N2}}" Width="90"/>
                        <DataGridTextColumn Header="2Y Sales" Binding="{Binding SalesTwoYear, StringFormat={}{0:N2}}" Width="90"/>
                        <DataGridTextColumn Header="2Y Profit" Binding="{Binding ProfitTwoYear, StringFormat={}{0:N2}}" Width="90"/>

                        <DataGridTextColumn Header="LY Orders" Binding="{Binding OrdersLastYear}" Width="80"/>
                        <DataGridTextColumn Header="LY Units" Binding="{Binding UnitsLastYear}" Width="80"/>
                        <DataGridTextColumn Header="LY Costs" Binding="{Binding CostsLastYear, StringFormat={}{0:N2}}" Width="90"/>
                        <DataGridTextColumn Header="LY Sales" Binding="{Binding SalesLastYear, StringFormat={}{0:N2}}" Width="90"/>
                        <DataGridTextColumn Header="LY Profit" Binding="{Binding ProfitLastYear, StringFormat={}{0:N2}}" Width="90"/>

                        <DataGridTextColumn Header="TY Orders" Binding="{Binding OrdersThisYear}" Width="80"/>
                        <DataGridTextColumn Header="TY Units" Binding="{Binding UnitsThisYear}" Width="80"/>
                        <DataGridTextColumn Header="TY Costs" Binding="{Binding CostsThisYear, StringFormat={}{0:N2}}" Width="90"/>
                        <DataGridTextColumn Header="TY Sales" Binding="{Binding SalesThisYear, StringFormat={}{0:N2}}" Width="90"/>
                        <DataGridTextColumn Header="TY Profit" Binding="{Binding ProfitThisYear, StringFormat={}{0:N2}}" Width="90"/>

                        <DataGridTextColumn Header="Rolling Orders" Binding="{Binding OrdersRolling}" Width="100"/>
                        <DataGridTextColumn Header="Rolling Units" Binding="{Binding UnitsRolling}" Width="95"/>
                        <DataGridTextColumn Header="Rolling Costs" Binding="{Binding CostsRolling, StringFormat={}{0:N2}}" Width="105"/>
                        <DataGridTextColumn Header="Rolling Sales" Binding="{Binding SalesRolling, StringFormat={}{0:N2}}" Width="105"/>
                        <DataGridTextColumn Header="Rolling Profit" Binding="{Binding ProfitRolling, StringFormat={}{0:N2}}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>