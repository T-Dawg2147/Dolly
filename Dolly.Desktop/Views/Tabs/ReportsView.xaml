<UserControl x:Class="Dolly.Desktop.Views.Tabs.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Dolly.Application.Models;assembly=Dolly.Application">

    <UserControl.Resources>

        <Style x:Key="ReportCategoryHeader" TargetType="Border">
            <Setter Property="Background" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#B7B7B7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="ReportTile" TargetType="Button">
            <Setter Property="Background" Value="#FCEBBE"/>
            <Setter Property="BorderBrush" Value="#D9C48A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- REPLACE the entire ReportItemTemplate (it referenced two undefined converters) -->
        <DataTemplate x:Key="ReportItemTemplate" DataType="{x:Type models:ReportDefinition}">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="28" Height="28"
                        Background="#1D6F42"
                        BorderBrush="#8C8C8C" BorderThickness="1">
                    <TextBlock Text="X"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" FontSize="12"/>
                </Border>

                <Button Grid.Column="2"
                        Style="{StaticResource ReportTile}"
                        Content="{Binding Title}"
                        ToolTip="{Binding Description}"
                        Command="{Binding DataContext.RunReportCommand,
                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="CategoryGroupHeader" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel Margin="0,0,16,0" Width="230">
                            <Border Style="{StaticResource ReportCategoryHeader}">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           FontSize="12"/>
                            </Border>
                            <ItemsPresenter Margin="0,6,0,0"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <!-- ADDED two rows above for the standalone folder button -->
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Search Reports"
                       Style="{StaticResource LabelTextBlock}"/>

            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Height="26" FontSize="12"/>
        </Grid>

        <!-- Reports, grouped by category, wraps to new rows as more are added -->
        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding FilteredReports}"
                      ItemTemplate="{StaticResource ReportItemTemplate}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource CategoryGroupHeader}">
                    <GroupStyle.Panel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </GroupStyle.Panel>
                </GroupStyle>
            </ItemsControl.GroupStyle>
        </ItemsControl>
        
        <!-- Special Reports Folder -->
        <Button Grid.Row="4"
                HorizontalAlignment="Left"
                Content="Open Specials Report Folder"
                Command="{Binding OpenSpecialsFolderCommand}"
                Padding="8,4"/>
    </Grid>
</UserControl>