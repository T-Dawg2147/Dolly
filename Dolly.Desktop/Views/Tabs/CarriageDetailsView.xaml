<UserControl x:Class="Dolly.Desktop.Views.Tabs.CarriageDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="365"
             d:DesignWidth="960"
             MinWidth="960">

    <UserControl.Resources>
        <Style x:Key="CarriageLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource LabelTextBlock}">
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CarriageTextBox"
               TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CarriageComboBox"
               TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CarriageHeader"
               TargetType="Border">
            <Setter Property="Background" Value="#EEF3DF"/>
            <Setter Property="BorderBrush" Value="#B7B7B7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <Style x:Key="MatrixCell"
               TargetType="Border">
            <Setter Property="BorderBrush" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="MatrixText"
               TargetType="TextBlock"
               BasedOn="{StaticResource LabelTextBlock}">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,8,12,8">

        <Grid.RowDefinitions>
            <RowDefinition Height="170"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP SECTION -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="490"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="205"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: CARRIAGE DETAILS -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Supplier"
                           Style="{StaticResource CarriageLabel}"/>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Text="{Binding Supplier}"
                         Style="{StaticResource CarriageTextBox}"
                         IsReadOnly="True"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Carriage is"
                           Style="{StaticResource CarriageLabel}"/>

                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Text="{Binding CarriageIs}"
                          ItemsSource="{Binding CarriageIsOptions}"
                          Style="{StaticResource CarriageComboBox}"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Carriage Type"
                           Style="{StaticResource CarriageLabel}"/>

                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding CarriageType}"
                         Style="{StaticResource CarriageTextBox}"/>

                <Button Grid.Row="2"
                        Grid.Column="2"
                        Grid.RowSpan="3"
                        Content="Edit"
                        Command="{Binding EditCommand}"
                        Margin="6,0,0,0"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Freight In %"
                           Style="{StaticResource CarriageLabel}"/>

                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Text="{Binding FreightInPercentage}"
                         Style="{StaticResource CarriageTextBox}"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Freight Out %"
                           Style="{StaticResource CarriageLabel}"/>

                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Text="{Binding FreightOutPercentage}"
                         Style="{StaticResource CarriageTextBox}"/>

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Min Order Charge"
                           Style="{StaticResource CarriageLabel}"/>

                <ComboBox Grid.Row="5"
                          Grid.Column="1"
                          Text="{Binding MinimumOrderCharge}"
                          ItemsSource="{Binding YesNoOptions}"
                          Style="{StaticResource CarriageComboBox}"/>

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Order Value"
                           Style="{StaticResource CarriageLabel}"/>

                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Text="{Binding OrderValue}"
                         Style="{StaticResource CarriageTextBox}"/>

                <TextBlock Grid.Row="6"
                           Grid.Column="2"
                           Text="{Binding OrderCharge}"
                           HorizontalAlignment="Right"
                           Style="{StaticResource CarriageLabel}"/>
            </Grid>

            <!-- CENTRE: ZONE DEFINITIONS -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource CarriageHeader}">
                    <TextBlock Text="Zone Definitions"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource MatrixCell}">
                        <TextBlock Text="A" Style="{StaticResource MatrixText}"/>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource MatrixCell}">
                        <TextBlock Text="B" Style="{StaticResource MatrixText}"/>
                    </Border>

                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource MatrixCell}">
                        <TextBlock Text="C" Style="{StaticResource MatrixText}"/>
                    </Border>

                    <Border Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource MatrixCell}">
                        <TextBlock Text="D" Style="{StaticResource MatrixText}"/>
                    </Border>

                    <Border Grid.Row="4"
                            Grid.Column="0"
                            Style="{StaticResource MatrixCell}">
                        <TextBlock Text="E" Style="{StaticResource MatrixText}"/>
                    </Border>

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Text="{Binding ZoneDefinitionA}"
                             Style="{StaticResource CarriageTextBox}"/>

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding ZoneDefinitionB}"
                             Style="{StaticResource CarriageTextBox}"/>

                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding ZoneDefinitionC}"
                             Style="{StaticResource CarriageTextBox}"/>

                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             Text="{Binding ZoneDefinitionD}"
                             Style="{StaticResource CarriageTextBox}"/>

                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             Text="{Binding ZoneDefinitionE}"
                             Style="{StaticResource CarriageTextBox}"/>
                </Grid>
            </Grid>

            <!-- RIGHT: YEAR, QUESTIONNAIRE AND NOTES -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="74"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Year and questionnaire -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Choose Year"
                                   Style="{StaticResource CarriageLabel}"/>

                        <ComboBox Text="{Binding SelectedYear}"
                                  ItemsSource="{Binding Years}"
                                  Style="{StaticResource CarriageComboBox}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Open Pricing&#x0a;Questionnaire"
                            Command="{Binding OpenPricingQuestionnaireCommand}"
                            Margin="6,8,0,0"
                            Height="34"/>
                </Grid>

                <!-- Northern Ireland delivery -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource CarriageHeader}">
                        <TextBlock Text="Northern Ireland Delivery"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="Northern Ireland"
                               Style="{StaticResource CarriageLabel}"/>

                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              Text="{Binding NorthernIrelandDelivery}"
                              ItemsSource="{Binding YesNoOptions}"
                              Style="{StaticResource CarriageComboBox}"/>

                    <TextBlock Grid.Row="2"
                               Text="Into Stock FOC"
                               Style="{StaticResource CarriageLabel}"/>

                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              Text="{Binding IntoStockFoc}"
                              ItemsSource="{Binding YesNoOptions}"
                              Style="{StaticResource CarriageComboBox}"/>
                </Grid>

                <!-- Notes -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource CarriageHeader}">
                        <TextBlock Text="Carriage Notes"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <TextBox Grid.Row="1"
                             Text="{Binding CarriageNotes}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource CarriageTextBox}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- BOTTOM: CARRIAGE MATRIX -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="205"/>
            </Grid.ColumnDefinitions>

            <!-- Matrix -->
            <Border Grid.Column="0"
                    BorderBrush="#B7B7B7"
                    BorderThickness="1"
                    Background="White">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header row -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource MatrixCell}"/>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Grid.ColumnSpan="10"
                            Background="#EEF3F7"
                            BorderBrush="#B7B7B7"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="Carriage Rates"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Row labels -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MatrixCell}">
                        <TextBlock Text="A" Style="{StaticResource MatrixText}"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MatrixCell}">
                        <TextBlock Text="B" Style="{StaticResource MatrixText}"/>
                    </Border>

                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource MatrixCell}">
                        <TextBlock Text="C" Style="{StaticResource MatrixText}"/>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource MatrixCell}">
                        <TextBlock Text="D" Style="{StaticResource MatrixText}"/>
                    </Border>

                    <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource MatrixCell}">
                        <TextBlock Text="E" Style="{StaticResource MatrixText}"/>
                    </Border>

                    <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource MatrixCell}">
                        <TextBlock Text="Stocked" Style="{StaticResource MatrixText}"/>
                    </Border>

                    <!-- Rate cells -->
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CarriageRateA1}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CarriageRateA2}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CarriageRateA3}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding CarriageRateA4}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding CarriageRateA5}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="1" Grid.Column="6" Text="{Binding CarriageRateA6}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding CarriageRateA7}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="1" Grid.Column="8" Text="{Binding CarriageRateA8}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="1" Grid.Column="9" Text="{Binding CarriageRateA9}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="1" Grid.Column="10" Text="{Binding CarriageRateA10}" Style="{StaticResource CarriageTextBox}"/>

                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CarriageRateB1}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding CarriageRateB2}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding CarriageRateB3}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding CarriageRateB4}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding CarriageRateB5}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="2" Grid.Column="6" Text="{Binding CarriageRateB6}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="2" Grid.Column="7" Text="{Binding CarriageRateB7}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="2" Grid.Column="8" Text="{Binding CarriageRateB8}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="2" Grid.Column="9" Text="{Binding CarriageRateB9}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="2" Grid.Column="10" Text="{Binding CarriageRateB10}" Style="{StaticResource CarriageTextBox}"/>

                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CarriageRateC1}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding CarriageRateC2}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding CarriageRateC3}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding CarriageRateC4}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="3" Grid.Column="5" Text="{Binding CarriageRateC5}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="3" Grid.Column="6" Text="{Binding CarriageRateC6}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="3" Grid.Column="7" Text="{Binding CarriageRateC7}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="3" Grid.Column="8" Text="{Binding CarriageRateC8}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="3" Grid.Column="9" Text="{Binding CarriageRateC9}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="3" Grid.Column="10" Text="{Binding CarriageRateC10}" Style="{StaticResource CarriageTextBox}"/>

                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CarriageRateD1}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding CarriageRateD2}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding CarriageRateD3}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding CarriageRateD4}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="4" Grid.Column="5" Text="{Binding CarriageRateD5}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="4" Grid.Column="6" Text="{Binding CarriageRateD6}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="4" Grid.Column="7" Text="{Binding CarriageRateD7}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="4" Grid.Column="8" Text="{Binding CarriageRateD8}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="4" Grid.Column="9" Text="{Binding CarriageRateD9}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="4" Grid.Column="10" Text="{Binding CarriageRateD10}" Style="{StaticResource CarriageTextBox}"/>

                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CarriageRateE1}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding CarriageRateE2}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding CarriageRateE3}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="5" Grid.Column="4" Text="{Binding CarriageRateE4}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="5" Grid.Column="5" Text="{Binding CarriageRateE5}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="5" Grid.Column="6" Text="{Binding CarriageRateE6}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="5" Grid.Column="7" Text="{Binding CarriageRateE7}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="5" Grid.Column="8" Text="{Binding CarriageRateE8}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="5" Grid.Column="9" Text="{Binding CarriageRateE9}" Style="{StaticResource CarriageTextBox}"/>
                    <TextBox Grid.Row="5" Grid.Column="10" Text="{Binding CarriageRateE10}" Style="{StaticResource CarriageTextBox}"/>

                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="10"
                             Text="{Binding StockedRate}"
                             Style="{StaticResource CarriageTextBox}"/>
                </Grid>
            </Border>

            <!-- Reserved spacing/right-side area -->
            <Border Grid.Column="2"
                    BorderBrush="#B7B7B7"
                    BorderThickness="1"
                    Background="White"
                    Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>