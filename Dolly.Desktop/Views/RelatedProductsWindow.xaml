<Window x:Class="Dolly.Desktop.Views.RelatedProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Related Products"
        Width="980" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PeBgBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Product Code" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Column="1" Text="{Binding ProductCode}" Style="{StaticResource PeReadOnlyTextBox}"/>
            <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PeButton}"/>
        </Grid>

        <GroupBox Grid.Row="2" Header="Related Products" Style="{StaticResource PeGroupBox}">
            <DataGrid ItemsSource="{Binding Related}"
                      SelectedItem="{Binding SelectedRelated}"
                      AutoGenerateColumns="False"
                      Style="{StaticResource PeDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Parent" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="Related Code" Binding="{Binding RelatedCode}" Width="130"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding RelatedDescription}" Width="*"/>
                    <DataGridTextColumn Header="Supplier" Binding="{Binding RelatedSupplier}" Width="120"/>
                    <DataGridCheckBoxColumn Header="Unlinked" Binding="{Binding Unlink}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add Related" Command="{Binding OpenAddDialogCommand}" Style="{StaticResource PeButton}"/>
            <Button Content="Unlink" Command="{Binding UnlinkSelectedCommand}" Style="{StaticResource PeButton}"/>
            <Button Content="Cancel"
                    Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}"
                    Command="{Binding CancelCommand}" Style="{StaticResource PeButton}"/>
            <Button Content="{Binding CloseButtonText}" Command="{Binding CloseOrSaveCommand}" Style="{StaticResource PeButton}"/>
        </StackPanel>
    </Grid>
</Window>