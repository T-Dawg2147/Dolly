<Window x:Class="Dolly.Desktop.Views.AddRelatedProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Related Product"
        Width="620" Height="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PeBgBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Parent Code" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Column="1" Text="{Binding RelatedParent}" Style="{StaticResource PeReadOnlyTextBox}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Related Code" Style="{StaticResource PeLabel}"/>
            <TextBox Grid.Column="1" Text="{Binding RelatedCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PeTextBox}"/>
            <Button Grid.Column="2" Content="Load" Command="{Binding LoadPreviewCommand}" Style="{StaticResource PeButton}"/>
        </Grid>

        <GroupBox Grid.Row="4" Header="Preview" Style="{StaticResource PeGroupBox}">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Preview.Code, StringFormat=Code: {0}}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Preview.SupplierCode, StringFormat=Supplier: {0}}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Preview.Description, StringFormat=Description: {0}}" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="{StaticResource PeBorderBrush}" BorderThickness="1" Background="White">
                    <Image Source="{Binding Preview.ImagePath}" Stretch="Uniform"/>
                </Border>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add" Command="{Binding AddCommand}" Style="{StaticResource PeButton}"/>
            <Button Content="Close" Command="{Binding CloseCommand}" Style="{StaticResource PeButton}"/>
        </StackPanel>
    </Grid>
</Window>